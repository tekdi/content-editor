{
  "compilerOptions": {
    "rootDir": ".",
    "baseUrl": ".",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "moduleResolution": "bundler",
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx",
    "useDefineForClassFields": true,
    "paths": {
      "@editor/editor-core": ["packages/editor-core/src/index.ts"],
      "@editor/editor-content": ["packages/editor-content/src/index.ts"],
      "@editor/editor-course": ["packages/editor-course/src/index.ts"],
      "@editor/editor-webcomponent": ["packages/editor-webcomponent/src/index.ts"],
      "@editor/shell-manage": ["packages/shell-manage/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "**/dist", "**/node_modules"]
}
