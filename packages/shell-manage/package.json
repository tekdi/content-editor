{
  "name": "@editor/shell-manage",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/shell-manage.umd.cjs",
  "module": "./dist/shell-manage.es.js",
  "exports": {
    ".": {
      "import": "./dist/shell-manage.es.js",
      "require": "./dist/shell-manage.umd.cjs"
    }
  },
  "types": "./dist/index.d.ts",
  "files": ["dist", "src"],
  "scripts": {
    "build:esm": "vite build --config vite.config.ts",
